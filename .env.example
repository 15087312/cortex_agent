# Model Provider (required)
MODEL_API_KEY=sk-...
MODEL_API_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_API_FORMAT=openai
MODEL_MAX_TOKENS=4096
MODEL_TEMPERATURE=0.7

# Embedding (optional — auto-downloaded on first run)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_FOLDER=data/embeddings

# Memory System
MEMORY_DB_PATH=data/memory.db
MEMORY_FAISS_INDEX=data/events_faiss.index
MEMORY_ID_MAP=data/events_id_map.json
MEMORY_REDUCE_ENABLED=true

# Causal System
CAUSAL_DB_PATH=data/causal.db
CAUSAL_MAX_ANCHORS=3
CAUSAL_MAX_NEIGHBORS_PER_HOP=10
CAUSAL_MAX_TREE_DEPTH=4
CAUSAL_MAX_EVENTS_RECALL=30
CAUSAL_MIN_CONFIDENCE=0.2

# Chat Engine
CHAT_MAX_ROUNDS=5
CHAT_CONTEXT_MAX_MESSAGES=50
CHAT_CONTEXT_MAX_TOKENS=8000

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Identity
ASSISTANT_NAME=MiMo
USER_NAME=User
