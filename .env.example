# ==================================================================
# Humanoid AGI — 环境配置示例
# ==================================================================
# 复制此文件为 .env 并根据需要修改
# 详细配置说明见：CONFIG_VALUE_EVOLUTION.md
# ==================================================================

# ===========================
# 用户配置
# ===========================
USER_NAME=用户

# ===========================
# 系统环境
# ===========================
APP_ENV=development
DEBUG=False
LOG_LEVEL=INFO
MAX_WORKERS=10

# ===========================
# 【核心】运行模式 — COMPANION_MODE
# ===========================
# False（工作模式）：完整工具委托，仅安全检测 ← 推荐生产环境
# True（陪伴模式）：情绪+价值观全开，委托受限 ← AI 助手模式
COMPANION_MODE=False

# ===========================
# 【核心】价值观进化系统
# ===========================
# 启用感知系统（规范违反实时检测）
PERCEPTION_ENABLED=True

# 启用差异检测器（后台对齐度趋势统计）
DIFFERENCE_DETECTOR_ENABLED=True

# 启用价值观对齐处理器（被动监测）
VALUE_ALIGNMENT_HANDLER_ENABLED=True

# ===========================
# 大模型配置（三档模型各需配置 key / url / name）
# ===========================
# 支持任何 OpenAI 兼容 API：DeepSeek / OpenAI / ModelScope / Groq / Mistral / 等
# 示例（DeepSeek）：  API_URL=https://api.deepseek.com/v1/chat/completions  NAME=deepseek-v4-flash
# 示例（OpenAI）：    API_URL=https://api.openai.com/v1/chat/completions    NAME=gpt-4o
# 示例（ModelScope）：API_URL=https://api-inference.modelscope.cn/v1/chat/completions  NAME=Qwen/Qwen3.5-397B-A17B

OPENAI_API_KEY=
OPENAI_API_BASE_URL=

# 大模型（主协调模型）
LARGE_MODEL_API_KEY=
LARGE_MODEL_API_URL=
LARGE_MODEL_NAME=
LARGE_MODEL_API_FORMAT=
# 支持格式：openai / dashscope / anthropic（留空自动检测）
# LARGE_MODEL_OPENROUTER_SUPPLIER=
#   OpenRouter 聚合网关的上游供应商偏好（如 "DeepInfra, Together"），
#   逗号分隔按优先级依次尝试；仅当该层 API 为 OpenRouter 时生效。
#   MEDIUM_MODEL_OPENROUTER_SUPPLIER / SMALL_MODEL_OPENROUTER_SUPPLIER 同理。

# 中模型（推理增强）
MEDIUM_MODEL_API_KEY=
MEDIUM_MODEL_API_URL=
MEDIUM_MODEL_NAME=

# 小模型（轻量推理）
SMALL_MODEL_API_KEY=
SMALL_MODEL_API_URL=
SMALL_MODEL_NAME=

# 视觉模型配置
# VISION_BACKEND: auto / api / mlx / transformers / mock
#   auto=按优先级自动检测（api > mlx > transformers）
VISION_BACKEND=auto

# 云端视觉 API（VISION_BACKEND=api 时必填，auto 模式有 Key 即自动启用）
# VISION_API_KEY=your_api_key
# VISION_API_URL=https://api.openai.com/v1        # 留空复用 OPENAI_API_BASE_URL
# VISION_API_MODEL=gpt-4o                          # 模型名（gpt-4o / qwen-vl-max 等）
# VISION_API_FORMAT=openai                         # openai / dashscope / 留空自动检测

# 本地视觉模型（可选，留空用默认值）
# VISION_LOCAL_MODEL=Qwen/Qwen2-VL-2B-Instruct    # transformers 路径
# VISION_MLX_MODEL=mlx-community/Qwen2-VL-7B-Instruct-4bit  # MLX 路径（Apple Silicon）

# ===========================
# Embedding & RAG
# ===========================
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_FOLDER=data/memory/embeddings/models
EMBEDDING_LOCAL_FILES_ONLY=False
# HuggingFace 镜像（国内用 https://hf-mirror.com）
HF_MIRROR=

# ===========================
# 向量数据库
# ===========================
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
VECTOR_DB_DIMENSION=768

# ===========================
# 上下文管理
# ===========================
# 大模型上下文窗口大小（token数）
# Qwen-Max: 128K, DeepSeek: 128K, GPT-4o: 128K, Claude: 200K
CONTEXT_WINDOW_SIZE=128000

# 触发压缩时，压缩到窗口的百分比（0.2 = 压缩到 20%）
CONTEXT_COMPRESS_RATIO=0.2

# ===========================
# 记忆配置
# ===========================
MEMORY_TTL_SHORT=3600        # 1 小时
MEMORY_TTL_LONG=86400        # 24 小时
MEMORY_VECTOR_DIMENSION=768

# ===========================
# 注意力系统
# ===========================
ATTENTION_WEIGHT_THRESHOLD=0.7
INTERRUPT_URGENCY_THRESHOLD=0.9
ATTENTION_IMPORTANCE_ENABLED=True
ATTENTION_IMPORTANCE_MODEL_ENABLED=False
ATTENTION_THRESHOLD_BASE=0.6
ATTENTION_THRESHOLD_SLOPE=0.5
ATTENTION_THRESHOLD_MIN=0.1
ATTENTION_THRESHOLD_MAX=0.6
ATTENTION_MAX_RECALL_LOW=5
ATTENTION_MAX_RECALL_MEDIUM=10
ATTENTION_MAX_RECALL_HIGH=20

# ===========================
# 安全配置
# ===========================
SECURITY_REVIEW_MODE=auto  # llm / user / auto

# ===========================
# 主动搭话（可选）
# ===========================
PROACTIVE_OUTREACH_ENABLED=True
PROACTIVE_OUTREACH_COOLDOWN_MINUTES=15
PROACTIVE_OUTREACH_IDLE_MINUTES=15

# ===========================
# MCP 外部工具（可选）
# ===========================
# MCP (Model Context Protocol) 接入外部工具和资源。
# 配置后可通过 mcp_discover / mcp_call_tool 发现和调用。
# 格式：JSON object，每个 key 是一个 server 名。
#
# screen_monitor: Touchpoint 降级方案 — 截图 + OpenCV/EasyOCR 纯视觉分析。
#   当 Touchpoint（无障碍 API）无法读取原生 UI 时（游戏/自定义渲染），
#   模型可通过 analyze_ui_elements / capture_and_analyze 等工具获取屏幕信息。
#
# 示例 - 文件系统访问：
# MCP_SERVERS={"filesystem":{"command":"npx","args":["-y","@anthropic/mcp-server-filesystem","./workspace"]}}
#
# 示例 - SQLite 数据库查询：
# MCP_SERVERS={"sqlite":{"command":"npx","args":["-y","@anthropic/mcp-server-sqlite","data/memory.db"]}}
#
# 示例 - 完整配置：
# MCP_SERVERS={
#   "fs":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","./"]},
#   "screen_monitor":{"command":"python","args":["infra/mcp/servers/screen_monitor_server.py"]}
# }
MCP_SERVERS=""

# ===========================
# CDP 端口配置（Electron/CEF 应用 UI 检测）
# ===========================
# 对于 Electron/CEF 应用（如网易云音乐），需要以 --remote-debugging-port=N 启动，
# 然后在这里配置端口号，TouchpointDetector 会自动通过 CDP 获取 WebView 内部的
# 完整 AX 元素树（远多于原生 AX 仅暴露的菜单栏）。
#
# 格式同 MCP_SERVERS 的 JSON object：{"应用名":端口号}
# 示例：
#   CDP_PORTS={"网易云音乐":9223}
#   CDP_PORTS={"网易云音乐":9223,"微信":9224}
CDP_PORTS=""

# ===========================
# 语音输入 / 输出
# ===========================
# 语音感知总开关（麦克风 + Whisper STT）
PERCEPTION_VOICE_ENABLED=False
# 触发模式: hotkey=全局热键开关录音 / wakeword=唤醒词持续监听（说"科特"触发）
PERCEPTION_VOICE_MODE=hotkey
# 热键模式全局热键（pynput 格式: f8 / <ctrl>+<space>）
# macOS 支持 <cmd>+<alt>+v；Windows 用 <ctrl>+<alt>+v（无 Command 键）
PERCEPTION_VOICE_HOTKEY=f8
# 结束词（完毕）作为停止词: 录音中说到"完毕"自动停止
PERCEPTION_VOICE_END_STOP=True
# 单次录音最大时长（秒）
PERCEPTION_VOICE_MAX_DURATION=60.0
# 录音中检测结束词的间隔（秒）
PERCEPTION_VOICE_END_CHECK_INTERVAL=3.0
# Whisper 模型大小 (tiny/base/small/medium/large)
PERCEPTION_VOICE_MODEL=tiny
# 语音识别语言
PERCEPTION_VOICE_LANGUAGE=zh
# 语音识别后是否自动触发大模型（总指挥思考）
PERCEPTION_VOICE_LLM_TRIGGER_ENABLED=False
# 唤醒词（wakeword 模式）
PERCEPTION_VOICE_WAKE_PREFIX=科特
PERCEPTION_VOICE_WAKE_SUFFIX=完毕
# TTS 输出（让角色说话）
OUTPUT_TTS_ENABLED=True
OUTPUT_TTS_LANGUAGE=zh
OUTPUT_TTS_OUTPUT_DIR=data/output
