# 输出系统的结构骨架：校验守卫 → 分发发射；分发内含文件落盘分支
export OutputPipe
eq OutputPipe = Guard · Emit

export Distrib
input Distrib: [Emit]
output Distrib: [Emit]
eq Distrib = Guard · (Write | Emit)

# L2 数据流：distribute(content, channel) -> ok；channel 经 console/file/api/voice 分发
eq DistribFlow = Retrieve(content) · Retrieve(channel) · Guard(content) · Guard(channel) · Emit(ok) · Write(ok)
