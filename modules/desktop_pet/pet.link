# desktop_pet 模块：桌宠对话链（独立页面形态）
#
# PetChat：会话入口 = 委托独立 ReAct 循环，回复落库（语音/按键触发也走这条链）
# PetLoop：桌宠专属循环（CustomLoop）= 思考节流 → 循环(ReAct 整轮) → 输出（持续多轮，直到停止/上下文满）
# PetReactCycle：标准 ReAct 单轮 = 循环(思考 → 工具·观察 | 输出)，工具轮无等待
# PetPersist：每轮产出落库（engine 层 on_message 通道，user 首次连同落库）
# 注：chat()/build_messages() 是简单委托/纯构造，不需要 L2 数据流注解（已删除幻影 flow）
export PetChat
eq PetChat = Think · Write
# PetLoop（run）：直接证据只有节流等待 + 结果返回；Loop(PetReactCycle) 经委托实现，
# v1 扁平证据模型不跨函数验证（cycle 体见 PetReactCycle）
export PetLoop
eq PetLoop = Throttle · Emit
export PetReactCycle
eq PetReactCycle = Loop(Think · (Tool · Observe | Emit))
export PetPersist
eq PetPersist = Retrieve · Write
