# database 模块：数据持久化
# 初始化 = 幂等守卫 → 建表写入；连接 = 守卫 → 提交写入；落库 = 守卫 → 查重 → 写入；查询 = 守卫 → 读取
# DbInit：`config.get_url()` 读的是配置，不是业务数据；真正动作是建引擎/建表 → Write。
# DbConn：会话上下文管理器只管分支、commit/rollback/close，取数发生在调用方。
export DbInit
eq DbInit = Guard · Write

export DbConn
eq DbConn = Guard · Write

export DbSave
eq DbSave = Guard · Retrieve · Write

export DbQuery
eq DbQuery = Retrieve
