# 记忆模块的结构骨架：检索是"嵌入→搜索→过滤→排序"，保存是"守卫→落盘"
export MemRetrieve
input MemRetrieve: [Write]
output MemRetrieve: [Retrieve]
eq MemRetrieve = Retrieve · Guard · Retrieve

export MemSaveInner
eq MemSaveInner = Guard · Write · Retrieve

# L2 数据流：retrieve(query) -> top_events；save(event) -> ok
eq MemRetrieveFlow = Retrieve(query) · Guard(query) · Retrieve(top_events) · Write(top_events)
eq MemSaveFlow = Retrieve(event) · Guard(event) · Write(event) · Retrieve(ok) · Write(ok)
